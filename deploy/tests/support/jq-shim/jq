#!/usr/bin/env node
// Minimal jq stand-in used by the tests only when the real jq is not installed.
// It supports exactly the filters used by dispatch-workflow-and-wait.sh.

const fs = require('fs');

const args = process.argv.slice(2);
const variables = {};
let raw = false;
const positional = [];

for (let i = 0; i < args.length; i++) {
  if (args[i] === '-r') {
    raw = true;
  } else if (args[i] === '--arg') {
    variables[args[i + 1]] = args[i + 2];
    i += 2;
  } else if (args[i] === '--argjson') {
    variables[args[i + 1]] = JSON.parse(args[i + 2]);
    i += 2;
  } else {
    positional.push(args[i]);
  }
}

const filter = positional[0];
const input = JSON.parse(fs.readFileSync(0, 'utf8'));

const print = value => {
  if (value === undefined) return;
  process.stdout.write((raw && typeof value === 'string' ? value : JSON.stringify(value)) + '\n');
};

switch (filter) {
  case '.ref':
    print(input.ref);
    break;
  case '.status':
    print(input.status);
    break;
  case '.conclusion // ""':
    print(input.conclusion || '');
    break;
  case '[.workflow_runs[].id] | max // 0': {
    const ids = input.workflow_runs.map(run => run.id);
    print(ids.length ? Math.max(...ids) : 0);
    break;
  }
  case '[.workflow_runs[] | select(.id > $before) | .id] | min // empty': {
    const ids = input.workflow_runs.map(run => run.id).filter(id => id > variables.before);
    print(ids.length ? Math.min(...ids) : undefined);
    break;
  }
  case '[.jobs[] | select(.name == $name) | .id] | .[0] // empty':
    print(input.jobs.filter(job => job.name === variables.name).map(job => job.id)[0]);
    break;
  case '[.[] | select(.title == $title) | .message] | .[0] // empty':
    print(input.filter(annotation => annotation.title === variables.title).map(annotation => annotation.message)[0]);
    break;
  default:
    console.error(`jq shim: unsupported filter ${filter}`);
    process.exit(99);
}
