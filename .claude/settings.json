{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Edit(/.env)",
      "Read(/deploy/.env.prod)",
      "Edit(/deploy/.env.prod)",
      "Read(**/environment.development.ts)",
      "Edit(**/environment.development.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-approved-change.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/report-traceability.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
